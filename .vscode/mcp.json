{
  "inputs": [
    {
      "id": "githubToken",
      "type": "promptString",
      "description": "GitHub token with Issues read/write permission",
      "password": true
    }
  ],
  "servers": {
    "echo-windows": {
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/mcp-echo.ps1"]
    },
    "calculate-windows": {
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/mcp-calculate.ps1"]
    },
    "get-time-windows": {
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/mcp-get-time.ps1"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "github-write-windows": {
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/github.ps1"],
      "env": {
        "GITHUB_TOKEN": "${input:githubToken}"
      }
    }
  }
}
